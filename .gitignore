# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/apps/web/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local JSON "database" - generated by scripts/seed, mutated at runtime (legacy, unreferenced)
/data/*.json
/data/*.jsonl
/data/*.tmp
!/data/.gitkeep

# store map photos uploaded via the admin panel
/apps/web/public/uploads/

# stray runtime data file / scratch assets, not project source
/.json
/ICON/
/שיווק/
/PROJECT_FILES.md
/STORE_LAYOUT_EDITOR_PLAN.md
