# Copy to .env.local. Not required until the real LLM classification layer is wired in.
ANTHROPIC_API_KEY=

# Vercel Postgres (Neon) connection string. Get it from Vercel dashboard ->
# project -> Storage -> your Postgres database -> ".env.local" tab.
DATABASE_URL=

# Vercel Blob read/write token. Get it from Vercel dashboard ->
# project -> Storage -> your Blob store -> ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# Admin panel login. Pick your own password, and generate a random secret
# (e.g. `openssl rand -base64 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Both need to be added manually to the Vercel project's Environment Variables too.
ADMIN_PASSWORD=
SESSION_SECRET=

# Google sign-in (customer accounts). Create an OAuth 2.0 Client ID (type "Web
# application") at https://console.cloud.google.com/apis/credentials and add the
# redirect URI `<your-app-url>/api/auth/google/callback` (e.g.
# http://localhost:3000/api/auth/google/callback for local dev). Email+password
# login works without these; Google login is hidden/disabled until they're set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google sign-in on the mobile app, via the native Google Sign-In SDK (not a
# browser redirect - Google blocks custom-URI-scheme redirects for new Android/
# iOS OAuth clients). Create an OAuth 2.0 Client ID of type "Android" (package
# com.smartroute.app + your dev/EAS build's SHA-1, from `eas credentials -p
# android`) at the same Google Cloud project as GOOGLE_CLIENT_ID above - it isn't
# referenced by value anywhere (Play Services matches it by package+cert), these
# vars just document it exists. The mobile app itself is configured with
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID = the *same value* as GOOGLE_CLIENT_ID above
# (see apps/mobile/.env.example), not a new client.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Optional. Absolute base URL of the app, used to build the Google OAuth redirect
# URI in production (behind a proxy the request origin can be wrong). Local dev
# falls back to the request origin, so this can be left blank there.
NAVIO_APP_URL=

# Public landing page (navio.co.il) store buttons. Leave NAVIO_PLAY_STORE_LIVE
# unset until the Play listing is published - the button shows "coming soon"
# instead of linking to a listing that doesn't exist yet. The App Store button
# is hidden until NAVIO_APP_STORE_URL is set.
NAVIO_PLAY_STORE_LIVE=
NAVIO_APP_STORE_URL=

# Android App Links (served at /.well-known/assetlinks.json) - lets the app open
# navio.co.il invite/shared-list links directly. Comma-separated SHA-256 signing
# cert fingerprints: the EAS build key (`eas credentials -p android`) and, once
# on Google Play, the Play App Signing key (Play Console -> App integrity).
ANDROID_CERT_SHA256=
