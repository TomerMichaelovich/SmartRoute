{
  "expo": {
    "name": "NAVIO",
    "slug": "smartroute-mobile",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartroute",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/18bdf0f4-1ce1-4d4a-958e-b8d0e3877632",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.smartroute.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_BACKGROUND_LOCATION"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "navio.co.il", "pathPrefix": "/household/join/" },
            { "scheme": "https", "host": "navio.co.il", "pathPrefix": "/my-list/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-navio.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-navio.png"
          }
        }
      ],
      "expo-font",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HelloWidget",
              "label": "NAVIO",
              "description": "Your active shopping list - check off items and jump back into the app.",
              "minWidth": "250dp",
              "minHeight": "300dp",
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "NAVIO צריכה גישה לתמונות כדי לקרוא רשימת קניות מתמונה.",
          "cameraPermission": "NAVIO צריכה גישה למצלמה כדי לצלם רשימת קניות."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NAVIO משתמשת במיקום כדי להשוות מחירים בסניפים שבעיר שלכם.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18bdf0f4-1ce1-4d4a-958e-b8d0e3877632"
      }
    },
    "owner": "tomermichaelo"
  }
}
