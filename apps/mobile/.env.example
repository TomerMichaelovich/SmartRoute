# Copy to .env.local and point at your machine's LAN IP where `next dev` (apps/web) is
# running, so a phone on the same Wi-Fi can reach it. Update if your LAN IP changes.
EXPO_PUBLIC_API_BASE_URL=http://10.0.0.4:3000

# Google sign-in on mobile, via the native Google Sign-In SDK
# (@react-native-google-signin/google-signin) - NOT a browser/PKCE redirect flow;
# Google blocks custom-URI-scheme redirects for new Android/iOS OAuth clients, so
# the native SDK is required. Two things to create at
# https://console.cloud.google.com/apis/credentials, in the same project as the
# web app's GOOGLE_CLIENT_ID:
#   1. An OAuth Client ID of type "Android": package com.smartroute.app + the SHA-1
#      of your dev/EAS build's signing key (`eas credentials -p android`). This
#      isn't referenced by client-id value anywhere in code - Google Play Services
#      matches it automatically by package name + signing certificate.
#   2. EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID below = the *same* value as the web app's
#      GOOGLE_CLIENT_ID (not a new client) - passed as `webClientId` so the SDK
#      also mints a server-verifiable idToken.
# The Google button is hidden until this is set. Requires rebuilding the dev
# client after adding the native module - see apps/mobile/README.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public site that shared links (household invites, shared lists) point at -
# these open the app directly via Android App Links (app.json intentFilters),
# otherwise the site's download page. Defaults to https://navio.co.il.
EXPO_PUBLIC_SITE_URL=
